# DevShield AI Backend Configuration

# Nebius Token Factory API Configuration
# Get your API key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Configurable NVIDIA model hosted on Nebius Token Factory:
# Examples:
#   nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
#   nvidia/Nemotron-4-340B-Instruct
#   nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Test Runner Configuration
DOCKER_IMAGE=python:3.11-slim
TEST_TIMEOUT_SECONDS=5
MAX_CODE_SIZE_BYTES=65536
MAX_OUTPUT_SIZE_BYTES=32768
