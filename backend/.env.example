# DevShield AI Backend Configuration

# Google Gemini API Configuration (Recommended)
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nebius Token Factory API Configuration (Alternative Provider)
# Get your API key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Test Runner Configuration
DOCKER_IMAGE=python:3.11-slim
TEST_TIMEOUT_SECONDS=5
MAX_CODE_SIZE_BYTES=65536
MAX_OUTPUT_SIZE_BYTES=32768
